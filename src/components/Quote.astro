---
const { author, class: className = "" } = Astro.props;
---
<figure class={`card p-6 bg-white w-full ${className}`}>
  <blockquote class="border-l-4 border-highlight pl-4 italic text-slate-700 text-xl md:text-2xl">
    <slot />
  </blockquote>
  {author && (
    <figcaption class="mt-3 text-base md:text-lg text-slate-600">
      — {author}
    </figcaption>
  )}
</figure>
